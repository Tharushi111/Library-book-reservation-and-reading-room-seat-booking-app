# ==============================================================================
# SLIIT Library - Development Environment Configuration
# ==============================================================================
# IMPORTANT:
# 1. Do NOT commit your actual .env file with secrets to Git.
# 2. Enter the credentials for your NEW Supabase Development project below.
# 3. Expo automatically exposes variables prefixed with EXPO_PUBLIC_ to the client.
# ==============================================================================

# Your NEW Supabase Development Project URL (e.g. https://xyzcompany.supabase.co)
EXPO_PUBLIC_SUPABASE_URL=https://your-new-dev-project-ref.supabase.co

# Your NEW Supabase Development Project Publishable / Anon Key (e.g. sb_publishable_... or eyJhbGciOi...)
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_new_dev_publishable_or_anon_key
